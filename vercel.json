{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.ts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "env": [
    "CLAUDE_API_KEY",
    "GOOGLE_API_KEY",
    "GROQ_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NOTION_TOKEN",
    "STRAPI_URL",
    "STRAPI_API_KEY",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_REDIRECT_URI"
  ]
}
